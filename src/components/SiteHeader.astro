---
import Button from './ui/Button.astro';

// `match` is what decides the active state, `to` is where the link actually
// goes. They diverge for Work: its href is the homepage anchor `/#work`
// (pathname never contains a hash, so comparing against that would never
// match), but a visitor browsing a case study at /work/<slug> is still
// looking at "Work" and the nav should say so.
const NAV = [
  { to: '/#work', match: '/work', label: 'Work' },
  { to: '/about', label: 'About' },
  { to: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;

// React Router's NavLink matched descendant paths by default (end={false}),
// so /work stayed active on /work/savr-app. Match that: exact match or a
// path segment prefix, not a bare string prefix (so /work doesn't light up
// on a hypothetical /workshop).
const isActive = (match: string) => pathname === match || pathname.startsWith(match + '/');
---

<header class="site-header">
  <a class="logo" href="/">Reese Ferguson</a>
  <nav class="site-nav" aria-label="Primary">
    {
      /* Hamburger — hidden above 768px (CSS), the only control shown below it.
        A real <button>, so no href; nav-menu.ts drives aria-expanded and the
        header's data-menu-open state. */
    }
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    {
      /* One element, two guises: the connected segmented bar on desktop and the
        dropdown panel below 768px. CSS does the swap — markup stays single-source. */
    }
    <div class="btn-group" id="site-menu">
      {
        NAV.map(({ to, match, label }) => (
          <Button variant="ghost" href={to} active={isActive(match ?? to)}>
            {label}
          </Button>
        ))
      }
      <Button variant="white" href="/resume.pdf" external>
        {/* Full label on desktop, short on narrow screens — see .cv-* in ui.css */}
        <span class="cv-full">Curriculum Vitae (CV)</span>
        <span class="cv-short">CV</span>
      </Button>
    </div>
  </nav>
</header>
