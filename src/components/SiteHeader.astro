---
const NAV = [
  { to: '/work', label: 'Work' },
  { to: '/about', label: 'About' },
  { to: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;

// React Router's NavLink matches descendant paths by default (end={false}),
// so /work stayed active on /work/savr-app. Match that: exact match or a
// path segment prefix, not a bare string prefix (so /work doesn't light up
// on a hypothetical /workshop).
const isActive = (to: string) => pathname === to || pathname.startsWith(to + '/');
---

<header class="site-header">
  <a class="logo" href="/">Reese Ferguson</a>
  <nav class="site-nav" aria-label="Primary">
    {
      NAV.map(({ to, label }) => (
        <a class={'nav-link' + (isActive(to) ? ' is-active' : '')} href={to}>
          {label}
        </a>
      ))
    }
    <a class="nav-link" href="/resume.pdf" target="_blank" rel="noopener">
      Résumé ↗
    </a>
  </nav>
</header>
