---
// Shared "snapshot" project card used on both the homepage and /work, per
// Reese's Paper mock (artboard "Home — current build", 3TO-0). Two visual
// states share one layout: `live` (default colour, glows on hover — every
// shipped/shippable project, including ones without a real link yet) and
// `soon` (everything muted/blurred, buttons disabled — projects not ready
// to show).
//
// The right-hand image is a plain placeholder rather than the case studies'
// `<MediaFrame>` convention: these cards are rendered from a data array (a
// bespoke list on the homepage, `CASE_SLUGS` on /work), not one-off JSX per
// card, so the dev editor's hint-based text search — which looks for a single
// literal `<MediaFrame hint="…">` occurrence per source file — can't target
// one card out of a loop. Dropping a real image in means editing the calling
// page's data array directly (import it, pass it as `image`).
import type { ImageMetadata } from 'astro';
import Button from './ui/Button.astro';

export type SnapshotStat = { value: string; label: string };

type Props = {
  eyebrow: string;
  title: string;
  blurb: string;
  meta: string[];
  stats: SnapshotStat[];
  state: 'live' | 'soon';
  caseHref: string;
  liveHref?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  class?: string;
};

const {
  eyebrow,
  title,
  blurb,
  meta,
  stats,
  state,
  caseHref,
  liveHref,
  image,
  imageAlt = '',
  class: extra,
} = Astro.props;

const imgSrc = typeof image === 'string' ? image : image?.src;
const cls = ['snapshot-card', `is-${state}`, extra].filter(Boolean).join(' ');
const soon = state === 'soon';
---

<div class={cls}>
  <div class="sc-text">
    <div class="sc-top">
      <div class="sc-titleblock">
        <p class="eyebrow">{eyebrow}{soon && ' (Coming soon)'}</p>
        <h3 class="sc-title">{title}</h3>
      </div>
      <p class="sc-blurb">{blurb}</p>
      <p class="sc-meta">
        {
          meta.map((segment, i) => (
            <>
              {i > 0 && <span class="accent"> · </span>}
              {segment}
            </>
          ))
        }
      </p>
    </div>

    <div class="sc-stats">
      {
        stats.map((stat) => (
          <div class="sc-stat">
            <span class="sc-stat-value">{stat.value}</span>
            <span class="sc-stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="sc-actions">
      <Button variant="ghost" href={caseHref} disabled={soon}> View case study </Button>
      {
        liveHref && (
          <Button variant="white" href={liveHref} external disabled={soon}>
            View Live
          </Button>
        )
      }
    </div>
  </div>

  <div class="sc-media">
    {imgSrc ? <img src={imgSrc} alt={imageAlt} /> : <span class="sc-media-hint">image</span>}
  </div>
</div>
