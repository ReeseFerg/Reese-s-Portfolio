---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal/Terminal';
import Container from '../components/ui/Container.astro';
import Flex from '../components/ui/Flex.astro';
import SnapshotCard from '../components/SnapshotCard.astro';

// Curated for the homepage, not generated from CASE_SLUGS: the design drops
// project-cadence and adds "Portfolio (WIP)", a non-route static card for the
// site itself. Copy supplied by Reese (RW-155). Only North Coast is shipped
// and measured, so it alone carries stats; the three `soon` cards omit the
// stats block and hide their "Visit Site" button until there's a public URL.
const SNAPSHOTS = [
  {
    state: 'live' as const,
    eyebrow: 'North Coast BJJ',
    title: 'Building potential newcomer trust in an intimidating sport',
    blurb:
      "Pro bono work redesigning North Coast's local business website by building trust signals and funnelling users to class sign-ups.",
    meta: ['Solo Product Designer', '2025–2026', 'Design & front end', 'Client project'],
    stats: [
      { value: '50', label: 'forum enquiries in first 30 days' },
      { value: '227', label: 'unique users in last 30 days' },
    ],
    caseHref: '/work/north-coast-bjj',
    // Keep in sync with the case study's "Visit Site" button (NorthCoastBjj.tsx).
    liveHref: 'https://northcoastbjj.co.uk',
  },
  {
    state: 'soon' as const,
    eyebrow: 'DataBrew',
    title: 'Front end design engineering project',
    blurb:
      'Creating the front end and branding for a developer tools summary extension alongside a back end developer',
    meta: ['branding, design front end', '2026', 'browser extension', 'in development'],
    caseHref: '/work/databrew',
  },
  {
    // Ghosted for now — not ready to show. Flip to 'live' when this site
    // itself is ready to link to; the hover glow comes for free at that
    // point, it's just the default state for every non-ghosted card.
    state: 'soon' as const,
    eyebrow: 'Portfolio',
    title: 'Codebase front end development work',
    blurb: 'Experimenting with design choices and front end architecture',
    meta: ['solo', '2026', 'design and front end', 'MVP complete'],
    caseHref: '/#work',
  },
  {
    state: 'soon' as const,
    eyebrow: 'SAVR Financial Literacy App',
    title: 'Google design case study',
    blurb: 'Coursework mobile app design mockups in Figma',
    meta: ['Solo', '2026'],
    caseHref: '/work/savr-app',
  },
];
---

<BaseLayout path="/">
  <Terminal slot="hero" client:load />

  <Container class="snapshots" id="work" size="3">
    <Flex direction="column" gap="6">
      {SNAPSHOTS.map((snap) => <SnapshotCard {...snap} />)}
    </Flex>
  </Container>
</BaseLayout>
