---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Flex from '../../components/ui/Flex.astro';
import SnapshotCard from '../../components/SnapshotCard.astro';
import { CASE_SLUGS, isDraft, type CaseSlug } from '../../lib/site.ts';

// One entry per CASE_SLUGS slug. Draft cases render as `soon` ghost cards
// rather than disappearing (isVisible only gated the old small work-card;
// SnapshotCard's `soon` state already renders no link to the excluded route,
// so draft-links.ts's build guard stays satisfied without an isVisible gate
// here). If Reese would rather keep drafts fully hidden on /work instead,
// filter CASE_SLUGS below with `.filter((slug) => !isDraft('/work/' + slug))`.
const WORK_CARDS: Record<
  CaseSlug,
  {
    eyebrow: string;
    title: string;
    blurb: string;
    meta: string[];
    liveHref?: string;
  }
> = {
  'north-coast-bjj': {
    eyebrow: 'Client project · Full case study',
    title: 'north-coast-bjj',
    blurb:
      '[TODO: one line — real client, real users, live site. Lead with what changed for the club.]',
    meta: ['[TODO: role]', '[TODO: year]', '[TODO: work type]', '[TODO: case study type]'],
    liveHref: '[TODO: north coast bjj URL]',
  },
  databrew: {
    eyebrow: 'Shipping',
    title: 'databrew',
    blurb:
      '[TODO: one line — a Chromium extension people will actually install. Say what it saves them.]',
    meta: [
      'Design & front end',
      '[TODO: year]',
      '[TODO: work type]',
      '[TODO: case study type]',
    ],
  },
  'savr-app': {
    eyebrow: 'Course project',
    title: 'savr-app',
    blurb: '[TODO: one line — lead with what user testing changed, not with the concept.]',
    meta: ['Solo', '2026', '[TODO: work type]', '[TODO: case study type]'],
  },
  'project-cadence': {
    eyebrow: 'In progress',
    title: 'project-cadence',
    blurb:
      "[TODO: one line on the idea. It's early — the interesting part is the open question.]",
    meta: ['Design & front end', '2026', '[TODO: work type]', '[TODO: case study type]'],
  },
};

const STAT_PLACEHOLDERS = [
  { value: '[TODO]', label: '[TODO]' },
  { value: '[TODO]', label: '[TODO]' },
];
---

<BaseLayout path="/work" bodyClass="routed">
  <section class="view is-active" id="work" aria-label="Selected work">
    <Container class="view-inner">
      <p class="crumb">~/reese/work</p>
      <h1 class="view-title">Selected work</h1>
      <p class="view-lead">
        I design interfaces and then build them — Figma and Paper for the thinking, Claude Code
        for the shipping. Start with north-coast-bjj; it's the one that went all the way.
      </p>

      <!-- Ordered strongest first. north-coast-bjj is the only one with a real client,
           real research and a finished product, so it leads and it's the only one that
           gets the full-depth treatment. -->
      <Flex class="work-grid" direction="column" gap="6">
        {
          CASE_SLUGS.map((slug) => {
            const card = WORK_CARDS[slug];
            const draft = isDraft(`/work/${slug}`);
            const state = draft ? 'soon' : 'live';
            return (
              <SnapshotCard
                state={state}
                eyebrow={card.eyebrow}
                title={card.title}
                blurb={card.blurb}
                meta={card.meta}
                stats={STAT_PLACEHOLDERS}
                caseHref={`/work/${slug}`}
                liveHref={card.liveHref}
              />
            );
          })
        }
      </Flex>

      <section class="shipped">
        <h2 class="shipped-title">Things that are live</h2>
        <ul class="shipped-list">
          <li>
            <a href="[TODO: north coast bjj URL]" target="_blank" rel="noopener">
              <span class="sh-name">north-coast-bjj</span>
              <span class="sh-desc">[TODO: one line — the site, in the wild]</span>
              <span class="sh-arrow">↗</span>
            </a>
          </li>
          <li>
            <a href="[TODO: databrew repo or store listing]" target="_blank" rel="noopener">
              <span class="sh-name">databrew</span>
              <span class="sh-desc"
                >[TODO: v1 of the extension — link the repo if it isn't listed yet]</span
              >
              <span class="sh-arrow">↗</span>
            </a>
          </li>
          <li>
            <a href="[TODO: this repo's URL]" target="_blank" rel="noopener">
              <span class="sh-name">this site</span>
              <span class="sh-desc"
                >Hand-built — routing, terminal and all. Designed in Figma and Paper, shipped
                with Claude Code.</span
              >
              <span class="sh-arrow">↗</span>
            </a>
          </li>
        </ul>
      </section>
    </Container>
  </section>
</BaseLayout>
