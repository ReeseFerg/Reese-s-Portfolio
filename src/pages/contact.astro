---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout path="/contact" bodyClass="routed">
  <section class="view is-active" id="contact" aria-label="Contact">
    <div class="view-inner">
      <p class="crumb">~/reese/contact</p>
      <h1 class="view-title">Get in touch</h1>
      <p class="view-lead">
        <span class="spark">✳</span> Open to opportunities — let's build something.
      </p>
      <ul class="contact-list">
        <li>
          <span class="ck">email</span> <a href="mailto:reesefergie@gmail.com">reesefergie@gmail.com</a>
        </li>
        <li>
          <span class="ck">linkedin</span> <a href="[TODO: LinkedIn URL]" target="_blank" rel="noopener"
            >[TODO: /in/your-handle]</a
          >
        </li>
        <li>
          <span class="ck">résumé</span> <a href="resume.pdf" target="_blank" rel="noopener">resume.pdf</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
