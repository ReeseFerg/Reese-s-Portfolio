---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import AboutCarousel, { type HobbyPhoto } from '../components/about/AboutCarousel';
import PhotoGallery from '../components/about/PhotoGallery';
import bjj from '../assets/about/bjj.jpg';
import bouldering from '../assets/about/bouldering.webp';
import f1 from '../assets/about/formula-one.jpg';
import hikeSummit from '../assets/about/hike-summit.jpg';
import graduation from '../assets/about/graduation.jpg';
import dogBeach from '../assets/about/dog-beach.jpg';

const photos = [
  { id: 'hike', image: hikeSummit.src, alt: 'Reese and friends at the summit of a hike' },
  { id: 'dog', image: dogBeach.src, alt: 'A dog mid-leap on a Scottish beach' },
  { id: 'graduation', image: graduation.src, alt: 'Reese and two friends in graduation gowns' },
];

const hobbies = [
  {
    title: 'Brazilian Jiu Jitsu',
    copy: [
      "BJJ is the art of folding clothes with people in them! It's great for the mind and body, building perseverance and mental toughness. It's a great hobby that I'd recommend anyone try.",
      'Oh, and I got my blue belt this year too!!',
    ],
    // TODO: swap the two painted placeholders for Reese's other two BJJ photos.
    photos: [
      { image: bjj.src, alt: 'Reese and a training partner in BJJ gis after class' },
      { palette: 'dusk', seed: 11 },
      { palette: 'alpine', seed: 27 },
    ] satisfies HobbyPhoto[],
  },
  {
    title: 'Bouldering',
    copy: [
      "Bouldering, or indoor climbing, is another hobby that's just better with friends! I love how it pushes you out of your comfort zone and allows you to socialise and build a community around you.",
      "If you ever thought about it, go for it! Everyone's super friendly, and the barrier to entry is low!",
    ],
    // TODO: Reese only has video for this one — swap `photos` for a `video`
    // (+ optional `videoPoster`/`videoAspect`) once that clip is in hand.
    photos: [
      { image: bouldering.src, alt: 'Wildflowers' },
      { palette: 'mist', seed: 42 },
      { palette: 'dawn', seed: 58 },
    ] satisfies HobbyPhoto[],
  },
  {
    title: 'Formula One',
    copy: [
      'My oldest obsession motorsport, is a big passion of mine, I enjoy tuning in every sunday to the races.',
      'My biggest pinch myself moment was winning paddock passes for the 2018 British GP!',
    ],
    // TODO: swap the two painted placeholders for Reese's other two F1 photos.
    photos: [
      { image: f1.src, alt: 'Formula One trackside' },
      { palette: 'alpine', seed: 63 },
      { palette: 'dusk', seed: 19 },
    ] satisfies HobbyPhoto[],
  },
];
---

<BaseLayout path="/about" bodyClass="routed">
  <section class="view is-active" id="about" aria-label="About">
    <Container class="view-inner">
      <p class="crumb">~/reese/about</p>
      <h1 class="about-title">a little about me</h1>
      <p class="about-intro">
        Growing up in the temperate climate of the Scottish highlands, I find myself
        experimenting, tinkering and soaking in as much learning from the many talented
        induviduals in the industry who help inspire me and push me to grow.
      </p>
      <p class="about-intro">
        My arrival to product design was definately not the orthodox approach, it involved lots
        of trials tribulations and failure. Leaving university after graduating in Business
        Management, I started a few businesses, failed at those busines, but grateful I stumbled
        into this work I truly love and want to grow in!
      </p>
      <PhotoGallery client:load photos={photos} ariaLabel="Photos of Reese" />
      <p class="about-intro">
        When I'm not focusing on work, my time is spent with family and friends, reading or
        enjoying some of my hobbies... also with my friends!
      </p>
      <AboutCarousel
        client:load
        aspect="3 / 4"
        height="auto"
        ariaLabel="Photos of Reese's hobbies"
        slides={hobbies.map((hobby) => ({
          title: hobby.title,
          paragraphs: hobby.copy,
          photos: hobby.photos,
        }))}
      />
    </Container>
  </section>
</BaseLayout>
