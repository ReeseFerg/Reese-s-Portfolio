---
import { ClientRouter } from 'astro:transitions';

import SiteHeader from '../components/SiteHeader.astro';
import DevPanel from '../components/dev/DevPanel';
import { metaForPath, SITE_NAME, SITE_URL } from '../lib/site.ts';

// Self-hosted JetBrains Mono (400/500/700) — must load before the seven site
// stylesheets below so tokens.css still wins on everything it declares.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';

// Fixed cascade order — tokens, base, terminal, views, case, dev, then
// responsive last, so its overrides still win exactly as they did in the
// single-file build. Do not reorder.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/terminal.css';
import '../styles/views.css';
import '../styles/case.css';
import '../styles/ui.css';
import '../styles/dev.css';
import '../styles/responsive.css';

interface Props {
  path: string;
  bodyClass?: string;
}

const { path, bodyClass } = Astro.props;
const meta = metaForPath(path);
const url = SITE_URL + meta.path;
const ogImage = `${SITE_URL}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />

    <!-- The site used to run on hash routes (`/#/work/savr-app`). Anything
         shared before the move — a link in a job application, a message to a
         recruiter — still arrives with that hash, so translate it to the real
         path once on load. Fragments never reach the server, so this can't be
         done at build time or by the host, and it must be is:inline and first:
         a bundled module script runs after CSS, which would flash the
         homepage before redirecting. -->
    <script is:inline>
      (function () {
        var hash = window.location.hash;
        if (hash.indexOf('#/') === 0) {
          window.location.replace(hash.slice(1));
        }
      })();
    </script>

    <!-- Restores the terminal's `--accent` theme onto <html> after every
         view-transition swap. Astro's default swap syncs documentElement's
         attributes from the incoming document, which would otherwise wipe the
         inline style Terminal.tsx sets; Terminal.tsx mirrors it to
         sessionStorage so this can put it back. Must be is:inline: a bundled
         module script runs after CSS and after the swap, which is too late to
         avoid a flicker. astro:after-swap fires before paint.

         Deliberately does NOT restore on a real document load (first visit or
         a hard reload) — pre-migration parity means a reload always resets to
         the default accent, on every route, not just the homepage where it's
         picked. Confirmed empirically (see task-5-report.md) that
         astro:after-swap never fires on a real load, only on a client-side
         swap — but the stored value is still cleared immediately below,
         belt-and-suspenders, so a stale value from earlier in this tab's
         session can't be picked up by this load or by the next swap either. -->
    <script is:inline>
      (function () {
        try {
          sessionStorage.removeItem('rf-accent');
        } catch (e) {
          // Storage can be unavailable (private mode) — nothing to clear.
        }
        document.addEventListener('astro:after-swap', function () {
          try {
            var accent = sessionStorage.getItem('rf-accent');
            if (accent) document.documentElement.style.setProperty('--accent', accent);
          } catch (e) {
            // Storage can be unavailable (private mode) — the default accent stands.
          }
        });
      })();
    </script>

    <!-- Per-route <title>, description and og: tags used to be spliced into the
         built HTML by the old Vite SPA's build-time SEO shell generator, because link scrapers
         (LinkedIn, Slack, iMessage, Twitter) fetch a page's HTML and read its
         meta tags without running JavaScript — a plain SPA shell would preview
         every URL with the homepage's title. Astro renders this per-route at
         build time instead, which is why src/lib/site.ts's route list exists:
         it is the single source these tags (and the sitemap) are built from. -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class={bodyClass}>
    <div id="root">
      <a class="skip-link" href="#main">Skip to content</a>
      <div class="read-progress" aria-hidden="true"><span id="readBar"></span></div>
      <SiteHeader />
      <slot name="hero" />
      <main class="views" id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    {import.meta.env.DEV && <DevPanel client:only="react" />}
    <script src="../scripts/route-focus.ts"></script>
  </body>
</html>
