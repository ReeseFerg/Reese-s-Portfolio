---
import { ClientRouter } from 'astro:transitions';

import SiteHeader from '../components/SiteHeader.astro';
import { metaForPath, SITE_NAME, SITE_URL } from '../lib/site.ts';

// Fixed cascade order — tokens, base, terminal, views, case, dev, then
// responsive last, so its overrides still win exactly as they did in the
// single-file build. Do not reorder.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/terminal.css';
import '../styles/views.css';
import '../styles/case.css';
import '../styles/dev.css';
import '../styles/responsive.css';

interface Props {
  path: string;
  bodyClass?: string;
}

const { path, bodyClass } = Astro.props;
const meta = metaForPath(path);
const url = SITE_URL + meta.path;
const ogImage = `${SITE_URL}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />

    <!-- Restores the terminal's `--accent` theme onto <html> before first paint
         and again after every view-transition swap. Astro's default swap syncs
         documentElement's attributes from the incoming document, which would
         otherwise wipe the inline style Terminal.tsx sets; Terminal.tsx mirrors
         it to localStorage so this can put it back. Must be is:inline: a
         bundled module script runs after CSS and after the swap, which is too
         late to avoid a flicker. astro:after-swap fires before paint. -->
    <script is:inline>
      (function () {
        function restoreAccent() {
          try {
            var accent = localStorage.getItem('rf-accent');
            if (accent) document.documentElement.style.setProperty('--accent', accent);
          } catch (e) {
            // Storage can be unavailable (private mode) — the default accent stands.
          }
        }
        restoreAccent();
        document.addEventListener('astro:after-swap', restoreAccent);
      })();
    </script>

    <!-- Per-route <title>, description and og: tags used to be spliced into the
         built HTML by the routeShells Vite plugin, because link scrapers
         (LinkedIn, Slack, iMessage, Twitter) fetch a page's HTML and read its
         meta tags without running JavaScript — a plain SPA shell would preview
         every URL with the homepage's title. Astro renders this per-route at
         build time instead, which is why src/lib/site.ts's route list exists:
         it is the single source these tags (and the sitemap) are built from. -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <div id="root">
      <a class="skip-link" href="#main">Skip to content</a>
      <div class="read-progress" aria-hidden="true"><span id="readBar"></span></div>
      <SiteHeader />
      <slot name="hero" />
      <main class="views" id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script src="../scripts/route-focus.ts"></script>
  </body>
</html>
