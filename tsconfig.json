{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "astro.config.mjs", "eslint.config.js"]
}
